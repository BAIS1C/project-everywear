{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@applets/*": ["../../applets/*"],
      "@everywear/ewds/css/*": ["../../packages/ewds/src/css/*"],
      "@everywear/ewds": ["../../packages/ewds/src/index.ts"],
      "@everywear/shared": ["../../packages/shared/src/index.ts"],
      "@everywear/transport": ["../../packages/transport/src/index.ts"]
    }
  },
  "include": ["src", "../../applets/*/src/**/*"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
