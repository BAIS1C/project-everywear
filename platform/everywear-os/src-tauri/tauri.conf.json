{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri-schema/main/tauri.schema.json",
  "productName": "Everywear OS",
  "version": "0.1.0",
  "identifier": "id.everywear.os",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Everywear OS",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "transparent": false,
        "visible": true
      },
      {
        "label": "studio",
        "title": "Everywear Studio",
        "url": "about:blank",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": false,
        "shadow": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: https:; media-src 'self' asset: http://asset.localhost https://asset.localhost data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' blob: 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' asset: http://asset.localhost https://asset.localhost http://127.0.0.1:* ws://127.0.0.1:* https://*.supabase.co https://forum.strandsnation.xyz https://huggingface.co https://*.huggingface.co https://api.open-meteo.com https://unpkg.com; frame-src http://127.0.0.1:* https://strandsnation.xyz https://*.strandsnation.xyz",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/Documents/Everywear Vault/**",
          "$HOME/Documents/Everywear Vault/.thumbnails/**",
          "$DOCUMENT/Everywear Vault/**",
          "$DOCUMENT/Everywear Vault/.thumbnails/**",
          "$HOME/.everywear/data/character-studio/**",
          "$RESOURCE/character-studio/**",
          "$RESOURCE/cs-assets/**"
        ]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
