{
  "name": "everywear",
  "version": "0.1.0",
  "private": true,
  "description": "Everywear OS: the Steam OS of AI one-click apps",
  "author": "Sean Uddin <somo@metafintek.xyz>",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "platform/everywear-os",
    "platform/everywear-os/src-tauri/sidecar/video-encoder",
    "applets/1magen",
    "applets/3nvizen",
    "applets/kasai",
    "applets/character-studio",
    "applets/gener8/web",
    "applets/vid/web",
    "applets/educ8"
  ],
  "scripts": {
    "dev:shell": "cd platform/everywear-os && npm run dev",
    "dev:1magen": "cd applets/1magen && npm run tauri dev",
    "build:ewds": "cd packages/ewds && npm run build",
    "lint": "eslint .",
    "clean": "rm -rf node_modules packages/*/node_modules applets/*/node_modules"
  },
  "devDependencies": {
    "typescript": "^5.5",
    "eslint": "^9",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0"
  }
